# 複製此檔為 .env 並填入實際值（.env 已被 .gitignore 排除）

# ProxySQL Admin 密碼 (格式: user:password;user2:password2)
PROXYSQL_ADMIN_CREDENTIALS=admin:changeme;radmin:changeme2

# ProxySQL monitor 帳號密碼
PROXYSQL_MONITOR_PASSWORD=changeme_monitor

# MySQL root 密碼
MYSQL_ROOT_PASSWORD=changeme_root

# sqlite-web 介面密碼
SQLITE_WEB_PASSWORD=changeme_sqlite
